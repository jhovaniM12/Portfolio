---
import { name } from "../data/site";
import { getTranslations, type Locale } from "../i18n/translations";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale).contact;
---
<section class="contact-section" id="contacto"><div class="wrap contact-grid">
  <div data-reveal="up"><p class="section-label">{t.label}</p><h2>{t.titleBefore}<em>{t.titleEm}</em></h2><p class="contact-lead">{t.lead}</p><div class="actions"><button class="button outline" type="button" disabled>{t.emailPending}</button><a class="button outline magnetic" href="#inicio">{t.backToTop} ↑</a></div></div>
  <form class="contact-form is-disabled" id="contact-form" data-reveal="up" data-reveal-delay="2">
    <div class="form-head"><div><h3>{t.formTitle}</h3><p>{t.formSubtitle}</p></div><span class="form-state"><i></i>{t.formBadge}</span></div>
    <fieldset disabled>
      <div class="form-grid">
        <div class="field"><input id="f-nombre" name="nombre" autocomplete="name" placeholder=" " /><label for="f-nombre">{t.nameLabel}</label><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4.5-6 8-6s7 2 8 6"/></svg></div>
        <div class="field"><input id="f-correo" type="email" name="correo" autocomplete="email" placeholder=" " /><label for="f-correo">{t.emailLabel}</label><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></svg></div>
      </div>
      <div class="topics" role="group" aria-label={t.topicGroupAria}><span>{t.topicLabel}</span>
        {t.topics.map((topic) => <label class="topic"><input type="radio" name="tipo" value={topic.value} /><b>{topic.label}</b></label>)}
      </div>
      <div class="field field-area"><textarea id="f-mensaje" name="mensaje" rows="5" maxlength="600" placeholder=" "></textarea><label for="f-mensaje">{t.messageLabel}</label><span class="counter" aria-hidden="true">0 / 600</span></div>
      <button class="button primary submit" type="submit"><span>{t.submitPending}</span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
    </fieldset>
    <p class="form-status" role="status">{t.formStatus}</p>
  </form>
</div>
<footer class="wrap footer"><span>© {new Date().getFullYear()} {name}</span><span>{t.footerLocation}</span></footer></section>
