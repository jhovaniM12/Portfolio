---
import { name } from "../data/site";
---
<section class="contact-section" id="contacto"><div class="wrap contact-grid">
  <div data-reveal="up"><p class="section-label">06 · Contacto</p><h2>¿Tienes un proyecto <em>en mente?</em></h2><p class="contact-lead">El canal directo de contacto estará disponible próximamente.</p><div class="actions"><button class="button outline" type="button" disabled>Correo pendiente</button><a class="button outline magnetic" href="#inicio">Volver arriba ↑</a></div></div>
  <form class="contact-form is-disabled" id="contact-form" data-reveal="up" data-reveal-delay="2">
    <div class="form-head"><div><h3>Envíame un mensaje</h3><p>Respondo normalmente en 24–48 h.</p></div><span class="form-state"><i></i>Próximamente</span></div>
    <fieldset disabled>
      <div class="form-grid">
        <div class="field"><input id="f-nombre" name="nombre" autocomplete="name" placeholder=" " /><label for="f-nombre">Nombre</label><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4.5-6 8-6s7 2 8 6"/></svg></div>
        <div class="field"><input id="f-correo" type="email" name="correo" autocomplete="email" placeholder=" " /><label for="f-correo">Correo electrónico</label><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></svg></div>
      </div>
      <div class="topics" role="group" aria-label="Tipo de proyecto"><span>Tipo de proyecto</span>
        <label class="topic"><input type="radio" name="tipo" value="web" /><b>Web / SaaS</b></label>
        <label class="topic"><input type="radio" name="tipo" value="api" /><b>Backend y APIs</b></label>
        <label class="topic"><input type="radio" name="tipo" value="cloud" /><b>Cloud</b></label>
        <label class="topic"><input type="radio" name="tipo" value="otro" /><b>Otro</b></label>
      </div>
      <div class="field field-area"><textarea id="f-mensaje" name="mensaje" rows="5" maxlength="600" placeholder=" "></textarea><label for="f-mensaje">Cuéntame sobre tu proyecto</label><span class="counter" aria-hidden="true">0 / 600</span></div>
      <button class="button primary submit" type="submit"><span>Formulario pendiente</span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
    </fieldset>
    <p class="form-status" role="status">Formulario desactivado hasta configurar un destino de envío.</p>
  </form>
</div>
<footer class="wrap footer"><span>© {new Date().getFullYear()} {name}</span><span>Cali, Colombia · Diseñado con intención.</span></footer></section>
