---
import { navItems } from "../data/site";
---
<div class="scroll-progress" aria-hidden="true"></div>
<nav class="site-nav" aria-label="Navegación principal"><div class="wrap nav-inner">
  <a class="logo" href="#inicio" aria-label="Inicio">JM<span>.</span></a>
  <div class="language-switch" role="group" aria-label="Idioma del portafolio">
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.4 2.4 3.6 5.4 3.6 9s-1.2 6.6-3.6 9c-2.4-2.4-3.6-5.4-3.6-9S9.6 5.4 12 3Z" /></svg>
    <span class="language-label">Idioma</span>
    <span class="language-options"><span class="language-option is-current" aria-current="true" lang="es">ES</span><button class="language-option language-option-pending" type="button" disabled aria-label="Versión en inglés pendiente" title="Versión en inglés pendiente" lang="en">EN</button></span>
  </div>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-links">Menú</button>
  <div class="nav-links" id="site-links">{navItems.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</div>
  <a class="nav-button magnetic" href="#contacto">Hablemos <span aria-hidden="true">↗</span></a>
</div></nav>
