---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getTranslations, type Locale } from "../i18n/translations";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale).nav;
const esUrl = getRelativeLocaleUrl("es", "");
const enUrl = getRelativeLocaleUrl("en", "");
---
<div class="scroll-progress" transition:name="scroll-progress" transition:animate="none" aria-hidden="true"></div>
<nav class="site-nav" transition:name="site-nav" transition:animate="none" aria-label={t.ariaLabel}><div class="wrap nav-inner">
  <a class="logo" href="#inicio" aria-label={t.homeAria}>JM<span>.</span></a>
  <div class="language-switch" role="group" aria-label={t.languageAria}>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.4 2.4 3.6 5.4 3.6 9s-1.2 6.6-3.6 9c-2.4-2.4-3.6-5.4-3.6-9S9.6 5.4 12 3Z" /></svg>
    <span class="language-label">{t.languageLabel}</span>
    <span class="language-options">
      <a class={`language-option${locale === "es" ? " is-current" : ""}`} href={esUrl} lang="es" hreflang="es" aria-current={locale === "es" ? "page" : undefined} aria-label={t.switchToEsAria}>ES</a>
      <a class={`language-option${locale === "en" ? " is-current" : ""}`} href={enUrl} lang="en" hreflang="en" aria-current={locale === "en" ? "page" : undefined} aria-label={t.switchToEnAria}>EN</a>
    </span>
  </div>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-links">{t.menu}</button>
  <div class="nav-links" id="site-links">{t.items.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</div>
  <a class="nav-button magnetic" href="#contacto">{t.cta} <span aria-hidden="true">↗</span></a>
</div></nav>
