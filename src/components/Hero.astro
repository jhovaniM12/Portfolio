---
import { Image } from "astro:assets";
import profile from "../images/profile.jpeg";
import galaxy from "../images/galaxy-hero.webp";
import { name, skills, iconUrl } from "../data/site";
import { getTranslations, type Locale } from "../i18n/translations";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale).hero;
---
<header class="hero" id="inicio">
  <div class="hero-galaxy" data-parallax="-0.08" style={`background-image: url(${galaxy.src})`} aria-hidden="true"></div>
  <canvas class="stars" aria-hidden="true"></canvas>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="hero-identity"><span class="hero-name">{name}</span><span class="eyebrow">{t.role}</span></p>
      <h1 aria-label={t.headlineAria}>
        <span class="line" aria-hidden="true"><span>{t.line1}</span></span>
        <span class="line" aria-hidden="true"><span>{t.line2Prefix}<em class="shimmer">{t.line2Em}</em></span></span>
        {t.line3 && <span class="line" aria-hidden="true"><span>{t.line3}</span></span>}
      </h1>
      <p class="hero-lead">{t.lead}</p>
      <div class="actions"><a class="button primary magnetic" href="#proyectos">{t.ctaProjects} <span>↗</span></a><a class="button outline magnetic" href="#contacto">{t.ctaContact}</a><button class="button cv-pending" type="button" disabled aria-describedby="cv-status">{t.ctaCv} <span aria-hidden="true">↓</span></button></div>
      <p class="pending-note" id="cv-status">{t.cvPending}</p>
    </div>
    <div class="portrait-wrap" data-parallax="0.05">
      <div class="portrait tilt" data-tilt-max="6"><Image src={profile} alt={t.portraitAlt} loading="eager" fetchpriority="high" /></div>
    </div>
  </div>
  <div class="wrap tech-strip">
    <span>{t.builtWith}</span>
    {[...skills[0].items.slice(0, 4), skills[1].items[2], skills[2].items[0]].map((s) => <span class="tech-icon-frame" title={s.name}><img class="tech-icon" src={iconUrl(s)} alt={s.name} width="26" height="26" loading="lazy" /></span>)}
    <div class="social-links" aria-label={t.socialAria}><span class="social-pending">{t.githubPending}</span><span class="social-pending">{t.linkedinPending}</span></div>
  </div>
  <a class="scroll-cue" href="#sobre-mi" aria-label={t.scrollAria}><span></span></a>
</header>
