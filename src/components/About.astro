---
import { getTranslations, type Locale } from "../i18n/translations";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale).about;
---
<section id="sobre-mi"><div class="wrap two-col">
  <div data-reveal="up"><p class="section-label">{t.label}</p><h2>{t.title}</h2></div>
  <div class="section-copy" data-reveal="up" data-reveal-delay="2">
    <p class="lead-copy">{t.lead}</p>
    <p>{t.body}</p>
    <div class="stats">
      {t.stats.map((s) => <div><strong data-count={s.count} data-suffix={s.suffix}>0</strong><span>{s.label}</span></div>)}
    </div>
    <div class="principles">
      {t.principles.map((p) => <div><strong>{p.num}</strong><span>{p.label}</span></div>)}
    </div>
  </div>
</div></section>
