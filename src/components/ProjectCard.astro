---
import type { Project } from "../data/projects";
import { projectTechnologyIcons } from "../data/project-technology-icons";
import ProjectVisual from "./ProjectVisual.astro";

interface Props {
  project: Project;
  index: number;
  total: number;
}

const { project, index, total } = Astro.props;
const projectNumber = String(index + 1).padStart(2, "0");
const projectTotal = String(total).padStart(2, "0");
---

<article
  class:list={["featured-project", `featured-project-${project.theme}`, { "featured-project-reversed": index % 2 === 1 }]}
  aria-labelledby={`project-title-${project.slug}`}
  data-reveal="up"
  data-reveal-delay={index + 1}
>
  <div class="featured-project-copy">
    <div class="featured-project-meta"><span>{projectNumber} / {projectTotal}</span><span>{project.type}</span></div>
    <h3 id={`project-title-${project.slug}`}>{project.title}</h3>
    <p class="featured-project-lead">{project.description}</p>
    <div class="featured-project-details">
      <div><h4>Qué resuelve</h4><p>{project.problem}</p></div>
      <div><h4>Cómo funciona</h4><p>{project.solution}</p></div>
    </div>
    <ul class="featured-project-stack" aria-label={`Tecnologías de ${project.title}`}>
      {project.stack.map((technology) => (
        <li class:list={[{ "project-tech-concept": !projectTechnologyIcons[technology] }]}>
          {projectTechnologyIcons[technology] && <span class="project-tech-mark"><img src={projectTechnologyIcons[technology]} alt="" aria-hidden="true" width="20" height="20" loading="lazy" decoding="async" /></span>}
          <span>{technology}</span>
        </li>
      ))}
    </ul>
    <a class="featured-project-link" href={`/proyectos/${project.slug}/`}>Explorar caso de estudio <span aria-hidden="true">↗</span></a>
  </div>
  <ProjectVisual project={project} />
</article>
