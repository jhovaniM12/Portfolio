---
import type { Project } from "../../data/projects";
import ProjectMedia from "../ProjectMedia.astro";

interface Props { project: Project }
const { project } = Astro.props;
const gallery = project.visualization?.type === "gallery" ? project.visualization : null;
---

{gallery && (
  <div class="project-visual project-visual-gallery" role="group" aria-label={`Capturas reales de ${project.title}`}>
    <div class="project-visual-heading"><span>Dentro del producto</span><span>{gallery.items.length} {gallery.items.length === 1 ? "captura" : "capturas"}</span></div>
    <div class="project-gallery-grid">
      {gallery.items.map((item) => <ProjectMedia media={item} />)}
    </div>
  </div>
)}
