---
import type { Project } from "../../data/projects";

interface Props { project: Project }
const { project } = Astro.props;
const visual = project.visualization?.type === "graph" ? project.visualization : null;
const nodeById = new Map(visual?.nodes.map((node) => [node.id, node]) ?? []);
const routePoints = visual?.exampleRoute.map((id) => nodeById.get(id)).filter((node) => node !== undefined).map((node) => `${node.x},${node.y}`).join(" ") ?? "";
---

{visual && (
  <div class="project-visual project-visual-graph" data-project-visual="graph" data-stage="0">
    <div class="project-visual-heading"><span>Explora la lógica</span><span aria-hidden="true">MAP / 02</span></div>
    <div class="graph-diagram">
      <svg viewBox="0 0 500 290" role="img" aria-label="Grafo esquemático con puntos conectados y una ruta de ejemplo">
        <path class="graph-gridline" d="M0 74H500M0 145H500M0 216H500M83 0V290M166 0V290M249 0V290M332 0V290M415 0V290" />
        {visual.edges.map(([from, to]) => {
          const start = nodeById.get(from);
          const end = nodeById.get(to);
          return start && end && <line class="graph-edge" x1={start.x} y1={start.y} x2={end.x} y2={end.y} />;
        })}
        <polyline class="graph-example-route" points={routePoints} />
        {visual.nodes.map((node, index) => <g class="graph-node" data-route-node={visual.exampleRoute.includes(node.id) ? "true" : "false"}><circle cx={node.x} cy={node.y} r="9"/><text x={node.x} y={node.y + (index % 2 === 0 ? 27 : -17)}>{node.id}</text></g>)}
      </svg>
    </div>
    <div class="project-visual-controls" role="group" aria-label={`Explorar ${project.title}`}>
      {visual.steps.map((step, index) => <button type="button" data-visual-step={index} aria-pressed={index === 0 ? "true" : "false"}><span>{step.label}</span><span aria-hidden="true">↗</span></button>)}
    </div>
    <div class="project-visual-story" aria-live="polite">
      {visual.steps.map((step, index) => <div data-visual-panel={index} hidden={index !== 0}><strong>{step.title}</strong><p>{step.description}</p></div>)}
    </div>
    <p class="project-visual-caption">{visual.caption}</p>
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-project-visual="graph"]').forEach((visual) => {
    visual.querySelectorAll<HTMLButtonElement>('[data-visual-step]').forEach((button) => button.addEventListener('click', () => {
      const step = button.dataset.visualStep;
      visual.dataset.stage = step;
      visual.querySelectorAll<HTMLButtonElement>('[data-visual-step]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      visual.querySelectorAll<HTMLElement>('[data-visual-panel]').forEach((panel) => { panel.hidden = panel.dataset.visualPanel !== step; });
    }));
  });
</script>
