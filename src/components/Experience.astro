---
import { getTranslations, type Locale } from "../i18n/translations";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale).experience;
---
<section id="experiencia"><div class="wrap">
  <p class="section-label" data-reveal="up">{t.label}</p>
  <h2 class="section-title" data-reveal="up">{t.title}</h2>
  <div class="timeline"><span class="timeline-line" aria-hidden="true"></span>
    {t.items.map((item, i) => (
      <article data-reveal="up" data-reveal-delay={i > 0 ? i + 1 : undefined}><small>{item.period}</small><h3>{item.title}</h3><p>{item.description}</p></article>
    ))}
  </div>
</div></section>
