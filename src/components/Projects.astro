---
import { Image } from "astro:assets";
import { projects } from "../data/projects";
import { getTranslations, type Locale } from "../i18n/translations";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale).projects;
---
<section id="proyectos"><div class="wrap">
  <p class="section-label" data-reveal="up">{t.label}</p>
  <h2 class="section-title" data-reveal="up">{t.titleLine1}<br />{t.titleLine2}</h2>
  <div class="project-filters" role="group" aria-label={t.filterAria} data-reveal="up">
    <span class="filter-pill" aria-hidden="true"></span>
    {t.filters.map(([id, label], i) => <button class={`pfilter${i === 0 ? " is-active" : ""}`} data-pfilter={id} aria-pressed={i === 0 ? "true" : "false"}>{label}</button>)}
  </div>
  <div class="project-grid">
    {projects.map((p) => (
      <article class={`project-card tilt${p.featured ? " is-featured" : ""}`} data-type={p.type} data-reveal="up" style={`--hue:${p.hue}`}>
        {p.image ? (
          <div class="project-cover has-image">
            <Image src={p.image} alt={p.title[locale]} loading="lazy" />
          </div>
        ) : (
          <div class="project-cover" aria-hidden="true"><span class="cover-orb"></span><span class="cover-grid"></span><span class="cover-mark">{p.title[locale].slice(0, 2).toUpperCase()}</span></div>
        )}
        <div class="project-body">
          <div class="project-meta"><span class={`badge badge-${p.type}`}>{t.badges[p.type]}</span><span>{p.period}</span>{p.role && <span>· {p.role[locale]}</span>}</div>
          <h3>{p.title[locale]}</h3>
          {p.subtitle && <p class="project-subtitle">{p.subtitle[locale]}</p>}
          <p>{p.summary[locale]}</p>
          {p.metrics && <ul class="metrics">{p.metrics.map((m) => <li><strong>{m.value[locale]}</strong><span>{m.label[locale]}</span></li>)}</ul>}
          {p.highlights && (
            <div class="project-highlights">
              <p class="highlights-title">{t.achievementsLabel}</p>
              <ul>{p.highlights[locale].map((item) => <li>{item}</li>)}</ul>
            </div>
          )}
          <ul class="chips">{p.stack.map((s) => <li>{s}</li>)}</ul>
          {p.links && <div class="project-links">{p.links.demo && <a href={p.links.demo}>{t.demo} ↗</a>}{p.links.repo && <a href={p.links.repo}>{t.code} ↗</a>}</div>}
        </div>
        <span class="card-glow" aria-hidden="true"></span>
      </article>
    ))}
  </div>
</div></section>
